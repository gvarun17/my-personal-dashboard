# Copy this file to .env.local and fill it in. .env.local is never committed.

# Your Garmin Personal API key (https://connect.garmin.com/app/settings/personalApiToken)
GARMIN_PERSONAL_API_KEY=

# Password for the web app. Required if anyone else can reach the port.
# Any username works unless you also set DASHBOARD_USER.
DASHBOARD_PASSWORD=
DASHBOARD_USER=

# Your time zone, so "today" is your today (e.g. Asia/Kolkata, Europe/London, America/New_York)
TZ=UTC

# How often to pull new data, in minutes (0 = only when you press Refresh)
REFRESH_MINUTES=60
